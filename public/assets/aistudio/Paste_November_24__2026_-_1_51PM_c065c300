    private static BridgeResponse ConnectVci(JObject request)
    {
        lock (StateLock)
        {
            try
            {
                if (IsConnected())
                    return GetStatus("VCI is already connected.");

                var devices = GetCdpDevices();
                if (devices.Count == 0)
                    return Failure("VCI_NOT_FOUND", "No supported USB VCI device was found.");

                uint? requestedIndex = null;
                if (request["device_index"] != null)
                {
                    JToken indexToken = request["device_index"];
                    if (indexToken.Type != JTokenType.Integer)
                        return Failure("INVALID_REQUEST", "device_index must be an integer.");

                    long indexValue = (long)indexToken;
                    if (indexValue < 0 || indexValue > uint.MaxValue)
                        return Failure("INVALID_REQUEST", "device_index is outside the valid range.");

                    requestedIndex = (uint)indexValue;
                }

                var target = requestedIndex.HasValue
                    ? devices.FirstOrDefault(d => d.Index == requestedIndex.Value)
                    : devices.FirstOrDefault();

                if (target == null)
                    return Failure("VCI_NOT_FOUND", "The requested VCI device index was not found.");

                var config = new VciDriverConfiguration(
                    DriverFamily.Cdp,
                    new[] { ConnectionMethod.DeviceDescription });
                config.DeviceDescription = target.Description;

                DriverLibrary.SetLogger(message =>
                    Log("sdk", new { message = message.Length > 1000 ? message.Substring(0, 1000) : message }));

                var library = new DriverLibrary();
                IVciDriver candidate = library.CreateDrivers(config).FirstOrDefault();
                if (candidate == null)
                    return Failure("DRIVER_NOT_CREATED", "The SDK did not create a CDP driver.");

                Result result = candidate.Connect();
                if (!result.Succeeded)
                {
                    candidate.Disconnect();
                    string sdkMessage = result.Error == null ? "SDK connection failed." : result.Error.ErrorMessage;
                    Log("connect_failed", new { error = sdkMessage });
                    return Failure("VCI_CONNECT_FAILED", sdkMessage);
                }

                if (!candidate.IsConnected)
                {
                    candidate.Disconnect();
                    return Failure("VCI_CONNECT_FAILED", "The SDK reported success but the driver is not connected.");
                }

                _driver = candidate;
                Log("vcI_connected", new { index = target.Index });
                return GetStatus("Official Autocom VCI connection established.");
            }
            catch (Exception ex)
            {
                _driver = null;
                Log("connect_error", new { error = ex.GetType().Name, message = ex.Message });
                return Failure("INTERNAL_ERROR", "VCI connection failed.");
            }
        }
    }

