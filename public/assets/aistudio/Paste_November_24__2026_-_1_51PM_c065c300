    private static BridgeResponse ReadAdapter(JObject request)
    {
        lock (StateLock)
        {
            if (!IsConnected())
                return Failure("VCI_NOT_CONNECTED", "Connect to the VCI before reading adapter information.");

            JToken operationToken = request["operation"];
            if (operationToken == null || operationToken.Type != JTokenType.String)
                return Failure("INVALID_REQUEST", "A string operation property is required.");

            string operation = ((string)operationToken).Trim().ToLowerInvariant();
            VciCommand command;

            switch (operation)
            {
                case "serial":
                    command = VciCommand.ReadSerial;
                    break;
                case "obd_firmware":
                    command = VciCommand.ObdFirmVersion;
                    break;
                case "eobd_firmware":
                    command = VciCommand.EobdFirmVersion;
                    break;
                case "platform":
                    command = VciCommand.ReadPlatformName;
                    break;
                case "communication_status":
                    command = VciCommand.CheckCommunicationStatus;
                    break;
                default:
                    return Failure("INVALID_OPERATION",
                        "Allowed operations are serial, obd_firmware, eobd_firmware, platform, and communication_status.");
            }

            try
            {
                var result = _driver.SendVciCommand(command);
                if (!result.Succeeded || result.Value == null)
                {
                    string sdkMessage = result.Error == null ? "The SDK read operation failed." : result.Error.ErrorMessage;
                    Log("adapter_read_failed", new { operation, error = sdkMessage });
                    return Failure("ADAPTER_READ_FAILED", sdkMessage);
                }

                string responseValue = result.Value.Response;
                if (string.IsNullOrWhiteSpace(responseValue))
                    responseValue = result.Value.RawResponse;

                Log("adapter_read", new { operation, succeeded = true });

                return new BridgeResponse
                {
                    Success = true,
                    Connected = true,
                    FtStatus = "VCI_CONNECTED",
                    DeviceCount = 1,
                    PendingRxBytes = (int)Math.Min(_driver.NumberOfBytesToRead(), int.MaxValue),
                    Message = "Adapter read completed.",
                    Error = null,
                    ErrorCode = null,
                    Operation = operation,
                    Value = responseValue
                };
            }
            catch (Exception ex)
            {
                Log("adapter_read_error", new { operation, error = ex.GetType().Name });
                return Failure("ADAPTER_READ_FAILED", "The adapter read operation failed.");
            }
        }
    }

