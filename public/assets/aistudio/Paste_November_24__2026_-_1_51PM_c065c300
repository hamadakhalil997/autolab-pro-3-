    private async Task InitializeAdapterAsync()
    {
        AddLog("Checking Autocom bridge...");
        bool available = await IsBridgeAvailableAsync();

        if (!available)
        {
            if (!File.Exists(BridgePath))
            {
                string message = "Bridge executable is missing beside the desktop application.";
                BridgeMessageText.Text = message;
                AddLog("ERROR: " + message);
                return;
            }

            try
            {
                var startInfo = new ProcessStartInfo
                {
                    FileName = BridgePath,
                    WorkingDirectory = AppContext.BaseDirectory,
                    UseShellExecute = false,
                    CreateNoWindow = true
                };

                Process? process = Process.Start(startInfo);
                process?.Dispose();
                AddLog("Starting the local Autocom bridge...");
            }
            catch (Exception ex)
            {
                BridgeMessageText.Text = "Bridge could not start: " + ex.Message;
                AddLog("ERROR: " + BridgeMessageText.Text);
                return;
            }
        }
        else
        {
            AddLog("Existing bridge detected.");
        }

        if (!await WaitForBridgeAsync())
        {
            string message = "Bridge did not become ready. Check the bridge log and named-pipe access.";
            BridgeMessageText.Text = message;
            AddLog("ERROR: " + message);
            return;
        }

        AddLog("Bridge is ready.");
        StartUiMonitor();

        try
        {
            BridgeResponse detection = await _bridge.EnumerateAsync();
            DeviceCountText.Text = detection.DeviceCount.ToString();

            if (!IsTargetDevicePresent(detection))
            {
                AddLog(detection.Message ?? "No supported Autocom VCI was detected.");
                UpdateConnectionDisplay(false, detection.PendingRxBytes);
                return;
            }

            AddLog($"Autocom VCI detected: {detection.DeviceCount} device(s).");
            BridgeResponse connection = await _bridge.ConnectAsync();
            if (!connection.Success || !connection.Connected)
            {
                AddLog("VCI connection failed: " +
                    (connection.Error ?? connection.Message ?? "Unknown error."));
                UpdateConnectionDisplay(false, connection.PendingRxBytes);
                return;
            }

            AddLog("Autocom VCI connected.");
            BridgeResponse status = await _bridge.GetStatusAsync();
            UpdateConnectionDisplay(status.Connected, status.PendingRxBytes);
            BridgeMessageText.Text = status.Message ?? "VCI status retrieved.";
        }
        catch (Exception ex)
        {
            BridgeMessageText.Text = "VCI initialization failed: " + ex.Message;
            AddLog("VCI initialization failed: " + ex.Message);
        }
    }

