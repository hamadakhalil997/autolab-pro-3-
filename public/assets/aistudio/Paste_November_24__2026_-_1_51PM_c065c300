    private async Task MonitorUsbStateAsync(CancellationToken cancellationToken)
    {
        bool? previousConnected = null;
        bool? previousDevicePresent = null;

        while (!cancellationToken.IsCancellationRequested)
        {
            try
            {
                BridgeResponse detection =
                    await _bridge.EnumerateAsync(cancellationToken);
                bool devicePresent = IsTargetDevicePresent(detection);
                bool connected = detection.Success && detection.Connected;
                DeviceCountText.Text = detection.DeviceCount.ToString();

                if (!devicePresent)
                {
                    if (previousDevicePresent == true)
                        AddLog("Autocom VCI was removed.");

                    _manualDisconnectRequested = false;
                    connected = false;
                }
                else
                {
                    if (previousDevicePresent == false)
                        AddLog("Autocom VCI was detected.");

                    if (!connected && !_manualDisconnectRequested)
                    {
                        BridgeResponse reconnect =
                            await _bridge.ConnectAsync(cancellationToken);
                        connected = reconnect.Success && reconnect.Connected;
                    }
                }

                UpdateConnectionDisplay(connected, detection.PendingRxBytes);
                if (previousConnected.HasValue &&
                    previousConnected.Value != connected)
                {
                    AddLog(connected
                        ? "VCI connection restored."
                        : "VCI connection lost.");
                }

                previousConnected = connected;
                previousDevicePresent = devicePresent;
            }
            catch (OperationCanceledException)
            {
                break;
            }
            catch (Exception ex)
            {
                SetBridgeStatus(false);
                if (previousConnected != false)
                    AddLog("VCI monitor error: " + ex.Message);
                previousConnected = false;
            }

            try
            {
                await Task.Delay(TimeSpan.FromSeconds(2), cancellationToken);
            }
            catch (OperationCanceledException)
            {
                break;
            }
        }
    }

    private void UpdateConnectionDisplay(bool connected, uint pendingBytes)
